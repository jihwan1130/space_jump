{
  "name": "orbit-jump-msstore",
  "productName": "궤도탈출",
  "version": "1.0.0",
  "description": "지구에서 우주 끝까지, 궤도를 갈아타며 날아오르는 원터치 점프 게임",
  "author": "jihwan1130",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "pack:dir": "npm run build && electron-builder --win dir",
    "pack:store": "npm run build && electron-builder --win appx"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^6.3.6"
  },
  "build": {
    "appId": "com.jihwan.orbitjump",
    "productName": "궤도탈출",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "appx"
      ],
      "icon": "build/icon.ico"
    },
    "appx": {
      "artifactName": "orbit-jump-${version}.appx",
      "identityName": "PixelPicnicGames.496108EF2542F",
      "publisher": "CN=D9A7311A-9854-4353-9E5A-9845EE3499D6",
      "publisherDisplayName": "픽셀피크닉게임즈 (Pixel Picnic Games)",
      "applicationId": "OrbitJump",
      "displayName": "궤도탈출",
      "languages": [
        "ko-KR",
        "en-US"
      ],
      "backgroundColor": "#05060f",
      "showNameOnTiles": true
    }
  }
}
